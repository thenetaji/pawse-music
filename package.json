{
  "name": "flow-music",
  "private": true,
  "packageManager": "pnpm@10.12.1",
  "scripts": {
    "dev": "pnpm --filter flow exec expo start",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "bundle:ios": "turbo run bundle:ios",
    "verify": "turbo run typecheck lint test",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "commitlint": "commitlint --edit"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.2.2",
    "@types/react-test-renderer": "^19.1.0",
    "babel-plugin-inline-import": "^3.0.0",
    "eslint": "^9.39.5",
    "eslint-config-expo": "^57.0.2",
    "jest": "^29.7.0",
    "jest-expo": "^57.0.5",
    "playwright": "^1.61.1",
    "prettier": "^3.9.9",
    "react-test-renderer": "^19.3.0",
    "turbo": "^2.11.7",
    "typescript": "~6.0.3"
  },
  "license": "GPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "https://github.com/thenetaji/flow-music.git"
  }
}

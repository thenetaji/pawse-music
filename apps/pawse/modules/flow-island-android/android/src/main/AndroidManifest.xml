<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <!-- The cat pill around the camera cutout ("Display over other apps", opt-in). -->
  <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

  <application>
    <receiver
      android:name="expo.modules.flowisland.FlowWidgetProvider"
      android:exported="true"
      android:label="@string/flow_widget_label">
      <intent-filter>
        <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
      </intent-filter>
      <meta-data
        android:name="android.appwidget.provider"
        android:resource="@xml/flow_widget_info" />
    </receiver>
    <!-- Play/pause and next from the widget; only our own PendingIntents reach it. -->
    <receiver
      android:name="expo.modules.flowisland.FlowActionReceiver"
      android:exported="false" />
  </application>
</manifest>

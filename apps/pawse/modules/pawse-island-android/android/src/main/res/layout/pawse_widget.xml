<?xml version="1.0" encoding="utf-8"?>
<!-- RemoteViews: only FrameLayout, LinearLayout, ImageView and TextView here. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:id="@+id/pawse_widget_root"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:background="@drawable/pawse_widget_bg"
  android:gravity="center_vertical"
  android:orientation="horizontal"
  android:padding="12dp">

  <ImageView
    android:id="@+id/pawse_widget_art"
    android:layout_width="78dp"
    android:layout_height="78dp"
    android:contentDescription="@string/pawse_widget_artwork"
    android:scaleType="centerCrop"
    android:src="@drawable/pawse_widget_art_placeholder" />

  <LinearLayout
    android:layout_width="0dp"
    android:layout_height="wrap_content"
    android:layout_marginStart="12dp"
    android:layout_weight="1"
    android:orientation="vertical">

    <TextView
      android:id="@+id/pawse_widget_title"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:ellipsize="end"
      android:maxLines="1"
      android:text="@string/pawse_widget_idle_title"
      android:textColor="#FFFFFFFF"
      android:textSize="15sp"
      android:textStyle="bold" />

    <TextView
      android:id="@+id/pawse_widget_artist"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="2dp"
      android:ellipsize="end"
      android:maxLines="1"
      android:text="@string/pawse_widget_idle_artist"
      android:textColor="#B3FFFFFF"
      android:textSize="13sp" />

    <LinearLayout
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_marginTop="10dp"
      android:orientation="horizontal">

      <FrameLayout
        android:id="@+id/pawse_widget_toggle"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:contentDescription="@string/pawse_widget_toggle">

        <ImageView
          android:id="@+id/pawse_widget_toggle_bg"
          android:layout_width="match_parent"
          android:layout_height="match_parent"
          android:importantForAccessibility="no"
          android:src="@drawable/pawse_widget_circle" />

        <ImageView
          android:id="@+id/pawse_widget_toggle_icon"
          android:layout_width="22dp"
          android:layout_height="22dp"
          android:layout_gravity="center"
          android:importantForAccessibility="no"
          android:src="@drawable/pawse_ic_play" />
      </FrameLayout>

      <FrameLayout
        android:id="@+id/pawse_widget_next"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginStart="8dp"
        android:contentDescription="@string/pawse_widget_next">

        <ImageView
          android:layout_width="match_parent"
          android:layout_height="match_parent"
          android:alpha="0.14"
          android:importantForAccessibility="no"
          android:src="@drawable/pawse_widget_circle" />

        <ImageView
          android:layout_width="20dp"
          android:layout_height="20dp"
          android:layout_gravity="center"
          android:importantForAccessibility="no"
          android:src="@drawable/pawse_ic_next" />
      </FrameLayout>
    </LinearLayout>
  </LinearLayout>

  <ImageView
    android:id="@+id/pawse_widget_cat"
    android:layout_width="72dp"
    android:layout_height="72dp"
    android:layout_gravity="bottom"
    android:layout_marginStart="6dp"
    android:contentDescription="@string/pawse_widget_cat"
    android:src="@drawable/pawse_cat_groove" />
</LinearLayout>

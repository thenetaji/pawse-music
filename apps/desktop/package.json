{
  "name": "pawse-desktop",
  "productName": "Pawse",
  "version": "0.6.0",
  "private": true,
  "description": "Pawse for Mac, Windows and Linux",
  "author": "thenetaji",
  "license": "GPL-3.0-or-later",
  "homepage": "https://github.com/thenetaji/pawse-music",
  "type": "module",
  "main": "src/main.mjs",
  "scripts": {
    "web": "node scripts/web.mjs",
    "start": "electron .",
    "dist": "electron-builder --publish never"
  },
  "devDependencies": {
    "electron": "44.7.0",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "com.thenetaji.pawse",
    "productName": "Pawse",
    "copyright": "Pawse contributors, GPL-3.0-or-later",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**",
      "web/**",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.music",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "identity": "-",
      "icon": "build/icon.png",
      "hardenedRuntime": false
    },
    "dmg": {
      "artifactName": "Pawse-${version}-mac-${arch}.${ext}"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "shortcutName": "Pawse",
      "artifactName": "Pawse-Setup-${version}.${ext}"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Audio",
      "icon": "build/icon.png",
      "synopsis": "A free music player with a cat",
      "maintainer": "thenetaji <thenetaji@users.noreply.github.com>",
      "syncDesktopName": true,
      "executableName": "pawse"
    },
    "appImage": {
      "artifactName": "Pawse-${version}-linux-x86_64.${ext}"
    },
    "deb": {
      "artifactName": "Pawse-${version}-linux-amd64.${ext}"
    },
    "publish": null
  },
  "desktopName": "pawse.desktop",
  "repository": {
    "type": "git",
    "url": "https://github.com/thenetaji/pawse-music.git"
  }
}

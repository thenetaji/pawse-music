+// Pawse patch: "Source error" alone hides the cause, so name the error code and any HTTP status.
+@OptIn(UnstableApi::class)
+internal fun describePlaybackError(error: PlaybackException): String {
+  var cause: Throwable? = error.cause
+  var status: Int? = null
+  var depth = 0
+  while (cause != null && status == null && depth++ < 8) {
+    if (cause is HttpDataSource.InvalidResponseCodeException) status = cause.responseCode
+    cause = cause.cause
+  }
+  val base = error.message ?: "Unknown playback error"
+  val code = error.errorCodeName
+  return if (status != null) "$base ($code, HTTP $status)" else "$base ($code)"
+}
